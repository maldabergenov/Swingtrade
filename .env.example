# ------------------------------------------------------------------
# Скопируйте файл в .env и подставьте свои значения:  cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).
# ------------------------------------------------------------------

# Токен бота от @BotFather. Обязателен.
TELEGRAM_BOT_TOKEN=123456789:AA...замените_на_свой_токен

# ID чата. Можно не указывать: напишите боту /start и он определится сам
# (команда `python -m swingscan telegram-test`), значение сохранится в state/.
TELEGRAM_CHAT_ID=

# --- расписание ---------------------------------------------------
TIMEZONE=Asia/Almaty
SCAN_TIMES=09:00,21:00

# --- фильтры вселенной --------------------------------------------
MIN_PRICE=5
MIN_MARKET_CAP=50000000
MIN_AVG_DOLLAR_VOLUME=3000000
MIN_AVG_VOLUME=200000
EXCLUDE_ETF=true
# MAX_SYMBOLS=200        # ограничение вселенной для отладки

# --- параметры сделки ---------------------------------------------
MIN_TARGET_PCT=0.20      # минимальная потенциальная прибыль
MAX_RISK_PCT=0.02        # максимальный риск на стоп-лосс
MIN_HOLD_DAYS=10         # ~2 недели торговых сессий
MAX_HOLD_DAYS=15         # ~3 недели торговых сессий

# Совместимость плана с волатильностью бумаги
MIN_STOP_ATR_RATIO=0.75  # стоп должен быть не меньше 0.75 × ATR%
MAX_TARGET_ATR_RATIO=1.0 # цель должна укладываться в ATR% × дни

# Требования к статистике сетапа на истории самой бумаги
MIN_BACKTEST_SIGNALS=5
MIN_BACKTEST_HIT_RATE=0.10
MIN_BACKTEST_EXPECTANCY_R=0.0

# --- выдача -------------------------------------------------------
MAX_RESULTS=10
MIN_SCORE=0
SEND_EMPTY_REPORT=true
INCLUDE_PARTIAL_BAR=true

# --- данные -------------------------------------------------------
HISTORY_PERIOD=2y
BATCH_SIZE=120
USE_CACHE=true
CACHE_TTL_MINUTES=180
BENCHMARK=SPY
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Маркет апдейт (market_update.py, workflow market-update, 09:00 Астаны)
# ------------------------------------------------------------------
# Telegram переиспользуется тот же — отдельных секретов не нужно.
# Всё, что ниже, опционально: без ключа соответствующий блок уходит
# в отчёт с пометкой «раздел временно недоступен».

# Котировки индексов/секторов и дополнительный поток новостей.
# Без ключа используется yfinance (без ключа, но без гарантий аптайма).
ALPHAVANTAGE_API_KEY=

# Пересказ заголовков на русском своими словами (Claude API).
# Без ключа заголовки уходят на языке оригинала с тематической меткой.
ANTHROPIC_API_KEY=
# MARKET_UPDATE_LLM=false          # полностью выключить пересказ
# MARKET_UPDATE_LLM_MODEL=claude-haiku-4-5

# Доступ к X/Twitter. Бесплатного X API больше нет — нужен платный тариф
# или сторонний провайдер. Выбор провайдера — в config/market_update.toml.
X_BEARER_TOKEN=                    # provider = "x_api"
X_API_KEY=                         # provider = "twitterapi_io" | "apidance"
# X_PROVIDER=none                  # перекрывает [x].provider из TOML
# X_RSS_BASE_URL=                  # provider = "rss" (Nitter/RSSHub)

# Прочие переопределения TOML-конфига
# MARKET_UPDATE_CONFIG=config/market_update.toml
# MARKET_UPDATE_LOOKBACK_HOURS=16
# MARKET_UPDATE_MAX_HEADLINES=7
# MARKET_UPDATE_MAX_TWEETS=6
